# ZeroTouchAlgo desk -> Telegram mirror
# Copy to config.env, fill in, and never commit the real file.

# --- Required ---------------------------------------------------------------
# Same JSON the /ltp Nifty board uses. Poll the desk file so a chip flip is
# not waiting on the website KV copy.
LIVE_URL=https://desk.zerotouchalgo.com/public-brief.json
# From @BotFather (never commit the real token)
TELEGRAM_BOT_TOKEN=123456789:REPLACE_ME
# Public channel username (@ZeroTouchAlgoDesk) or numeric id (-100xxxxxxxxxx)
TELEGRAM_CHAT_ID=@ZeroTouchAlgoDesk
# Private owner chat for health alerts only — never the public channel.
# Numeric id from @userinfobot. Leave empty to log-only.
OWNER_CHAT_ID=

# --- Boards and timing ------------------------------------------------------
# Cash indexes during NSE hours. btc-options is 24/7 via ALWAYS_OPEN_BOARDS.
BOARDS=nifty,banknifty,sensex,crudeoil,natgas,btc-options
ALWAYS_OPEN_BOARDS=btc-options
# Same-host briefs (preferred). HTTP LIVE_URL is the fallback.
BRIEF_DIR=/var/lib/strike-desk
POLL_SECONDS=5
# CoA publishes every 60s; 180s avoids skipping a chip flip at the interval edge.
STALE_SECONDS=180
SESSION_START=09:15
SESSION_END=15:30
LAST_TAG_ALERT=15:20
RECAP_TIME=15:35

# --- Guard rails ------------------------------------------------------------
COOLDOWN_SECONDS=300
MAX_TAGS_PER_SESSION=6
# Exchange holidays, YYYY-MM-DD, comma separated.
# Weekday NSE Capital Market closures for 2026 from:
#   NSE/CMTR/71775 (12 Dec 2025) https://nsearchives.nseindia.com/content/circulars/CMTR71775.pdf
#   NSE/CMTR/72260 (12 Jan 2026) https://nsearchives.nseindia.com/content/circulars/CMTR72260.pdf
# Checked 29 Oct 2026. Weekend-dated holidays omitted (the bot already skips Sat/Sun).
# 2027: NSE has not published a trading-holiday circular yet — do not guess.
HOLIDAYS=2026-01-15,2026-01-26,2026-03-03,2026-03-26,2026-03-31,2026-04-03,2026-04-14,2026-05-01,2026-05-28,2026-06-26,2026-09-14,2026-10-02,2026-10-20,2026-11-10,2026-11-24,2026-12-25

# Desk sentence in posts. Keep false until counsel signs off the wording.
INCLUDE_DESK_NOTE=false

# true = log posts instead of sending (use for the first live session)
DRY_RUN=true

# --- Links and storage ------------------------------------------------------
SITE_URL=https://zerotouchalgo.com/ltp
TRADETRON_URL=https://tradetron.tech/user-profiles/824766
DATA_DIR=/var/lib/zta-desk
